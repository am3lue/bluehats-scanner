# BlueHats Scanner local configuration

# Port for the API / production server
PORT=8787

# Public origin used for canonical URLs, sitemap and Open Graph tags.
VITE_SITE_URL=https://bluehats-scanner.vercel.app

# Optional: Turso database for the review queue (recommended on Vercel).
# Leave empty to use the local JSON store instead.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional free-key reputation adapters. Each stays "not configured" when empty.
GOOGLE_SAFE_BROWSING_KEY=
URLHAUS_AUTH_KEY=
VIRUSTOTAL_API_KEY=
PHISHTANK_KEY=
CLOUDFLARE_RADAR_TOKEN=

# Reputation feeds: core (default) or full (adds the 11 MB Phishing.Database list).
FEEDS=core

# Set to 0 to disable the local demo fixture pages.
DEMO_FIXTURES=1
